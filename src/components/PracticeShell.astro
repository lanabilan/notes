---

<div
  class="bg-background text-foreground flex min-h-dvh w-full max-w-full flex-col overflow-x-hidden"
  style="padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);"
>
  <header class="shrink-0 px-4 pt-4 pb-2">
    <h1 class="text-foreground text-3xl font-bold tracking-tight sm:text-4xl">ReadTheKey</h1>
    <p class="text-muted-foreground mt-1 text-sm sm:text-base">Practice coming soon</p>
  </header>

  <section class="border-border mx-4 shrink-0 border-b py-3" aria-label="Score">
    <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Score</p>
    <div class="mt-1 min-h-8" aria-hidden="true"></div>
  </section>

  <section class="border-border mx-4 flex min-h-0 flex-1 flex-col border-b py-3" aria-label="Staff">
    <p class="text-muted-foreground shrink-0 text-xs font-medium tracking-wide uppercase">Staff</p>
    <div class="mt-2 min-h-32 flex-1" aria-hidden="true"></div>
  </section>

  <section class="mx-4 flex min-h-0 flex-1 flex-col py-3 pb-4" aria-label="Piano">
    <p class="text-muted-foreground shrink-0 text-xs font-medium tracking-wide uppercase">Piano</p>
    <div class="mt-2 min-h-32 flex-1" aria-hidden="true"></div>
  </section>
</div>
