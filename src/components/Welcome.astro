---
import Topbar from "@/components/Topbar.astro";
---

<div class="bg-background text-foreground relative min-h-dvh w-full max-w-full overflow-x-hidden">
  <div class="relative z-10 p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
      <h1 class="text-foreground mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">ReadTheKey</h1>
      <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
        Practice reading staff notes on an on-screen piano — free, no ads.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="/auth/signin"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-lg px-6 py-3 text-base font-medium transition-colors"
        >
          Sign In
        </a>
        <a
          href="/auth/signup"
          class="border-border text-foreground hover:bg-muted inline-flex items-center justify-center rounded-lg border px-6 py-3 text-base font-medium transition-colors"
        >
          Sign Up
        </a>
      </div>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-6 px-4 pb-24 sm:grid-cols-3">
      <div class="border-border bg-card rounded-xl border p-6">
        <h3 class="mb-2 text-lg font-semibold">Staff → key</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          See a note on the staff, tap the matching piano key, get instant feedback.
        </p>
      </div>

      <div class="border-border bg-card rounded-xl border p-6">
        <h3 class="mb-2 text-lg font-semibold">Mobile-first</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Built for phone practice — large tap targets, one screen, no scroll maze.
        </p>
      </div>

      <div class="border-border bg-card rounded-xl border p-6">
        <h3 class="mb-2 text-lg font-semibold">Guest-friendly</h3>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Start practicing without an account. Optional sign-in comes later for saved progress.
        </p>
      </div>
    </div>
  </div>
</div>
