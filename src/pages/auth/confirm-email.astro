---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <div
    class="bg-background text-foreground flex min-h-dvh w-full max-w-full items-center justify-center overflow-x-hidden p-4"
    style="padding: max(1rem, env(safe-area-inset-top, 0px)) max(1rem, env(safe-area-inset-right, 0px)) max(1rem, env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));"
  >
    <div class="border-border bg-card w-full max-w-sm rounded-xl border p-8 text-center">
      <h1 class="text-foreground mb-3 text-2xl font-bold tracking-tight">{content.heading}</h1>
      <p class="text-muted-foreground mb-6">{content.description}</p>
      <a
        href="/auth/signin"
        class="text-foreground inline-flex min-h-11 items-center text-sm font-medium underline-offset-4 hover:underline"
      >
        {content.linkText}
      </a>
      <a
        href="/"
        class="text-foreground mt-2 inline-flex min-h-11 w-full items-center justify-center px-2 text-sm font-medium underline-offset-4 hover:underline"
      >
        Back to practice
      </a>
    </div>
  </div>
</Layout>
