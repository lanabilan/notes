---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <div
    class="bg-background text-foreground flex min-h-dvh w-full max-w-full items-center justify-center overflow-x-hidden p-4"
    style="padding: max(1rem, env(safe-area-inset-top, 0px)) max(1rem, env(safe-area-inset-right, 0px)) max(1rem, env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));"
  >
    <div class="border-border bg-card w-full max-w-sm rounded-xl border p-8">
      <h1 class="text-foreground mb-6 text-center text-2xl font-bold tracking-tight">Sign in</h1>
      <form method="POST" action="/api/auth/oauth">
        <button
          type="submit"
          class="bg-primary text-primary-foreground hover:bg-primary/90 flex min-h-11 w-full items-center justify-center rounded-lg px-4 py-2 font-medium transition-colors"
        >
          Sign in with Google
        </button>
      </form>
      <div class="text-muted-foreground my-4 flex items-center gap-3 text-sm">
        <span class="border-border h-px flex-1 border-t"></span>
        <span>or</span>
        <span class="border-border h-px flex-1 border-t"></span>
      </div>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Don't have an account? <a href="/auth/signup" class="text-foreground underline-offset-4 hover:underline"
          >Sign up</a
        >
      </p>
      <a
        href="/"
        class="text-foreground mt-2 inline-flex min-h-11 w-full items-center justify-center px-2 text-sm font-medium underline-offset-4 hover:underline"
      >
        Back to practice
      </a>
    </div>
  </div>
</Layout>
